# ==========================================
# SUPABASE DEV ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================
SUPABASE_DEV_URL=https://<your-dev-project-ref>.supabase.co
SUPABASE_DEV_ANON_KEY=<your-dev-anon-key>
SUPABASE_DEV_DB_URL=postgresql://postgres:<password>@db.<your-dev-project-ref>.supabase.co:5432/postgres
SUPABASE_DEV_PROJECT_REF=<your-dev-project-ref>

# Dev Google OAuth Provider Settings
GOOGLE_DEV_CLIENT_ID=<your-google-client-id>
GOOGLE_DEV_CLIENT_SECRET=<your-google-client-secret>
GOOGLE_DEV_CALLBACK_URL=https://<your-dev-project-ref>.supabase.co/auth/v1/callback

# ==========================================
# SUPABASE PROD ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================
SUPABASE_PROD_URL=https://<your-prod-project-ref>.supabase.co
SUPABASE_PROD_ANON_KEY=<your-prod-anon-key>
SUPABASE_PROD_DB_URL=postgresql://postgres:<password>@db.<your-prod-project-ref>.supabase.co:5432/postgres
SUPABASE_PROD_PROJECT_REF=<your-prod-project-ref>

# Prod Google OAuth Provider Settings
GOOGLE_PROD_CLIENT_ID=<your-google-client-id>
GOOGLE_PROD_CLIENT_SECRET=<your-google-client-secret>
GOOGLE_PROD_CALLBACK_URL=https://<your-prod-project-ref>.supabase.co/auth/v1/callback
