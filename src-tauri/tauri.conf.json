{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rem-Lays",
  "version": "1.5.0",
  "identifier": "app.remlays.desktop",
  "build": {
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:4200",
    "frontendDist": "../dist/rem-lays/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Rem-Lays",
        "url": "app.html",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "plugins": {
    "deep-link": {
      "schemes": ["remlays"]
    },
    "updater": {
      "endpoints": [
        "https://github.com/Abhay-Maheshwari/Rem-Lays/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCQkMzMDY2MzY2RjZGQUQKUldTdGIyODJaakM4cXpZT0kwYW00RlBEYmpxSDlwc2J3c3IxQXRGQWllWG95QnU3TVZ3NU5QZlMK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
